@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix archetype: <https://w3id.org/archetype/ontology/> .
@prefix archsh:    <https://w3id.org/archetype/shapes/> .
@prefix crm:       <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crm-tx:    <http://www.cidoc-crm.org/extensions/crmtex/> .
@prefix oa:        <http://www.w3.org/ns/oa#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix data:      <https://digipal.eu/data/> .

#################################################################
# Archetype application profile: resource links (SHACL) — draft v0.1
#
# DESCRIPTIVE, not a validation suite. Each NodeShape lists, for one
# kind of node in the Archetype RDF export, which property leads to
# which other kind of node — i.e. "what path do I follow from X to Y".
# No cardinalities are asserted.
#
# Generated from:
#   - data_pstokes_turtle_202609222044.rdf (every resource-to-resource
#     triple, grouped by subject kind / property / object kind);
#   - creation_rdf.py (links the code can emit but which have no
#     DigiPal data: marked "not populated in DigiPal");
#   - archetype_ontology_0.1.ttl (class names).
# Literal-valued properties are deliberately out of scope for this pass.
#
# Reading the shapes:
#   - "Outgoing" property shapes: sh:path is the property as it appears
#     in the data, from this node to the other.
#   - "Incoming" property shapes use sh:inversePath: the triple is stored
#     on the OTHER node, pointing at this one. The export materialises
#     only the forward property, so a SPARQL query must use the forward
#     property with the variables swapped (e.g. ?itempart
#     crm:P56_bears_feature ?hand), NOT the CRM inverse (P56i_is_found_on),
#     unless a reasoner is used. The CRM inverse name is given in the
#     description for reference only.
#   - Shapes carry sh:targetClass only where the Archetype node kind has
#     a class of its own that no other kind shares (directly or through
#     a subclass). Kinds that share a generic CRM class (e.g. the five
#     kinds of crm:E13_Attribute_Assignment) have no target; their
#     rdfs:comment says how to recognise them.
#   - Constants such as data:Type_Accepted are DigiPal data URIs; see
#     the accompanying note.
#
# Namespace archsh: is PROVISIONAL (not yet agreed).
#################################################################

<https://w3id.org/archetype/shapes/>
    a owl:Ontology ;
    rdfs:label "Archetype application profile — resource links (draft)"@en ;
    owl:versionInfo "0.1" ;
    owl:imports <https://w3id.org/archetype/ontology/0.1/> .


#################################################################
# Palaeographic core: letters, graphs, components
#################################################################

archsh:CharacterShape
    a sh:NodeShape ;
    sh:targetClass archetype:Character ;
    rdfs:label "Character"@en ;
    sh:property [
        sh:path crm:P138_represents ;
        sh:class archetype:Ontograph ;
        sh:description "Outgoing: Character -P138_represents-> Ontograph. The Ontograph this Character belongs to."@en
    ] ;
    sh:property [
        sh:path crm:P148_has_component ;
        sh:class archetype:GenericComponent ;   # CHECK!!
        sh:description "Outgoing: Character -P148_has_component-> Generic Component. Type level: the Components this Character is made up of."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Character -P2_has_type-> Character form (E55 Type)."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class archetype:Allograph ;
        sh:description "Incoming: Allograph -P138_represents-> this Character. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] .

archsh:AllographShape
    a sh:NodeShape ;
    sh:targetClass archetype:Allograph ;
    rdfs:label "Allograph"@en ;
    sh:property [
        sh:path crm:P138_represents ;
        sh:class archetype:Character ;
        sh:description "Outgoing: Allograph -P138_represents-> Character. The Character of which this Allograph is a form."@en
    ] ;
    sh:property [
        sh:path crm:P148_has_component ;
        sh:class archetype:GenericComponent ;     # TO CHANGE: VisualComponent
        sh:description "Outgoing: Allograph -P148_has_component-> Generic Component. Type level: the Components this Allograph is made up of (no Features recorded at this level)."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class archetype:Idiograph ;
        sh:description "Incoming: Idiograph -P138_represents-> this Allograph. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] .

archsh:IdiographShape
    a sh:NodeShape ;
    sh:targetClass archetype:Idiograph ;
    rdfs:label "Idiograph"@en ;
    sh:property [
        sh:path crm:P138_represents ;
        sh:class archetype:Allograph ;
        sh:description "Outgoing: Idiograph -P138_represents-> Allograph. The Allograph of which this Idiograph is one scribe's realisation."@en
    ] ;
    sh:property [
        sh:path crm:P148_has_component ;
        sh:class archetype:VisualComponent ;
        sh:description "Outgoing: Idiograph -P148_has_component-> Visual Component. The Visual Components (component + features) recorded for this Idiograph."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P148_has_component ] ;
        sh:class archetype:Scribal_Practice ;
        sh:description "Incoming: Scribal Practice -P148_has_component-> this Idiograph. (CRM inverse P148i_is_component_of; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P65_shows_visual_item ] ;
        sh:class archetype:Graph ;
        sh:description "Incoming: Graph -P65_shows_visual_item-> this Idiograph. (CRM inverse P65i_is_shown_by; not materialised in the export.)"@en
    ] .

archsh:GraphShape
    a sh:NodeShape ;
    sh:targetClass archetype:Graph ;
    rdfs:label "Graph"@en ;
    sh:property [
        sh:path crm:P46_is_composed_of ;
        sh:class archetype:GraphComponent ;
        sh:description "Outgoing: Graph -P46_is_composed_of-> Graph Component. The physical components (ascender, minim, etc.) annotated on this Graph."@en
    ] ;
    sh:property [
        sh:path crm:P65_shows_visual_item ;
        sh:class archetype:Idiograph ;
        sh:description "Outgoing: Graph -P65_shows_visual_item-> Idiograph. The Idiograph of which this physical Graph is an instance. Continue Idiograph -P138-> Allograph -P138-> Character."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:class archetype:HandInstance ;
        sh:description "Incoming: Hand Instance -P46_is_composed_of-> this Graph. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath oa:hasBody ] ;
        sh:class oa:Annotation ;
        sh:description "Incoming: Annotation -hasBody-> this Graph."@en
    ] .

archsh:GraphComponentShape
    a sh:NodeShape ;
    sh:targetClass archetype:GraphComponent ;
    rdfs:label "Graph Component"@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class archetype:Feature ;
        sh:description "Outgoing: Graph Component -P2_has_type-> Feature. The Features observed on this component of this Graph."@en
    ] ;
    sh:property [
        sh:path crm:P65_shows_visual_item ;
        sh:class archetype:GenericComponent ;
        sh:description "Outgoing: Graph Component -P65_shows_visual_item-> Generic Component. The generic Component this physical component shows."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:class archetype:Graph ;
        sh:description "Incoming: Graph -P46_is_composed_of-> this Graph Component. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] .

archsh:VisualComponentShape
    a sh:NodeShape ;
    sh:targetClass archetype:VisualComponent ;
    rdfs:label "Visual Component"@en ;
    rdfs:comment "Instances currently all come from the idiographcomponent table (URIs data:IdiographComponent_<id>)."@en ;
    sh:property [
        sh:path crm:P138_represents ;
        sh:class archetype:GenericComponent ;
        sh:description "Outgoing: Visual Component -P138_represents-> Generic Component. The generic Component this Visual Component realises."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class archetype:Feature ;
        sh:description "Outgoing: Visual Component -P2_has_type-> Feature. The Features recorded on this component of the Idiograph."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P148_has_component ] ;
        sh:class archetype:Idiograph ;          # Add also all Generic Allographs. Then can specify (e.g.) features for Caroline a, etc.
        sh:description "Incoming: Idiograph -P148_has_component-> this Visual Component. (CRM inverse P148i_is_component_of; not materialised in the export.)"@en
    ] .

archsh:GenericComponentShape
    a sh:NodeShape ;
    sh:targetClass archetype:GenericComponent ;
    rdfs:label "Generic Component"@en ;
    sh:property [
        sh:path crm:P2_has_type ;  # Change to 'archetype:permits feature'
        sh:class archetype:Feature ;
        sh:description "Outgoing: Generic Component -P2_has_type-> Feature. The Features this Component MAY bear (the permitted-feature list from component_features), not Features observed on any Graph."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class archetype:VisualComponent ;
        sh:description "Incoming: Visual Component -P138_represents-> this Generic Component. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] ;
    sh:property [ # Drop: force all Generalised Allographs to go through Visual Component for consistency
        sh:path [ sh:inversePath crm:P148_has_component ] ;
        sh:or ( [ sh:class archetype:Allograph ] [ sh:class archetype:Character ] ) ;
        sh:description "Incoming: Allograph or Character -P148_has_component-> this Generic Component. (CRM inverse P148i_is_component_of; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P65_shows_visual_item ] ;
        sh:class archetype:GraphComponent ;
        sh:description "Incoming: Graph Component -P65_shows_visual_item-> this Generic Component. (CRM inverse P65i_is_shown_by; not materialised in the export.)"@en
    ] .

archsh:FeatureShape
    a sh:NodeShape ;
    sh:targetClass archetype:Feature ;
    rdfs:label "Feature"@en ;
    sh:property [
        sh:path [ sh:inversePath crm:P2_has_type ] ;
        sh:or ( [ sh:class archetype:GenericComponent ] [ sh:class archetype:GraphComponent ] [ sh:class archetype:VisualComponent ] ) ; # CHANGE GenericComponent
        sh:description "Incoming: Generic Component or Graph Component or Visual Component -P2_has_type-> this Feature. (CRM inverse P2i_is_type_of; not materialised in the export.)"@en
    ] .

archsh:OntographShape
    a sh:NodeShape ;
    sh:targetClass archetype:Ontograph ;
    rdfs:label "Ontograph"@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Ontograph -P2_has_type-> Ontograph type (E55 Type)."@en # Represents Category in DigiPal
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class archetype:Character ;
        sh:description "Incoming: Character -P138_represents-> this Ontograph. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] .


#################################################################
# Hands, scribes and writing
#################################################################

archsh:HandInstanceShape
    a sh:NodeShape ;
    sh:targetClass archetype:HandInstance ;
    rdfs:label "Hand Instance"@en ;
    sh:property [
        sh:path crm:P1_is_identified_by ;
        sh:class crm:E41_Appellation ;
        sh:description "Outgoing: Hand Instance -P1_is_identified_by-> Locus. Locus of the hand within its Item Part."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:or ( [ sh:class archetype:Appearance ] [ sh:class crm:E55_Type ] ) ;
        sh:description "Outgoing: Hand Instance -P2_has_type-> Appearance or Category. Appearance of the hand. Glossed-text category (from Hand.glossed_text_id)."@en
    ] ;
    sh:property [
        sh:path crm:P46_is_composed_of ;
        sh:class archetype:Graph ;
        sh:description "Outgoing: Hand Instance -P46_is_composed_of-> Graph. The Graphs written in this Hand Instance."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P108_has_produced ] ;
        sh:class crm-tx:TX2_Writing ;
        sh:description "Incoming: Writing event -P108_has_produced-> this Hand Instance. (CRM inverse P108i_was_produced_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class crm:E36_Visual_Item ;
        sh:description "Incoming: Image -P138_represents-> this Hand Instance. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P140_assigned_attribute_to ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Hand date attribution or Hand place attribution -P140_assigned_attribute_to-> this Hand Instance. (CRM inverse P140i_was_attributed_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P56_bears_feature ] ;
        sh:class archetype:Item_Part ;
        sh:description "Incoming: Item Part -P56_bears_feature-> this Hand Instance. (CRM inverse P56i_is_found_on; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P67_refers_to ] ;
        sh:class crm:E31_Document ;
        sh:description "Incoming: Hand description -P67_refers_to-> this Hand Instance. (CRM inverse P67i_is_referred_to_by; not materialised in the export.)"@en
    ] .

archsh:WritingEventShape
    a sh:NodeShape ;
    sh:targetClass crm-tx:TX2_Writing ;
    rdfs:label "Writing event"@en ;
    rdfs:comment "One Writing per Hand Instance (URIs data:Writing_<hand id>)."@en ;
    sh:property [
        sh:path crm:P108_has_produced ;
        sh:class archetype:HandInstance ;
        sh:description "Outgoing: Writing event -P108_has_produced-> Hand Instance. The Hand Instance produced by this Writing. Scribe, Script and Latin Style hang off the Writing, not the Hand Instance: HandInstance <-P108- Writing -P14-> Scribe."@en
    ] ;
    sh:property [
        sh:path crm:P14_carried_out_by ;
        sh:class archetype:Scribe ;
        sh:description "Outgoing: Writing event -P14_carried_out_by-> Scribe. The Scribe who carried out this Writing."@en
    ] ;
    sh:property [
        sh:path crm:P33_used_specific_technique ;  # TO REVIEW: see discussion R6
        sh:class crm-tx:TX10_Style ;
        sh:description "Outgoing: Writing event -P33_used_specific_technique-> Latin Style (TX10 Style) or Script (TX10 Style). Script and Latin Style as techniques of the Writing (deliberately not CRMtex TXP12_has_style on the Hand Instance; see creation_rdf.py)."@en
    ] .

archsh:ScribeShape
    a sh:NodeShape ;
    sh:targetClass archetype:Scribe ;
    rdfs:label "Scribe"@en ;
    sh:property [
        sh:path archetype:characterised_by ;
        sh:class archetype:Scribal_Practice ;
        sh:description "Outgoing: Scribe -characterised_by-> Scribal Practice. The Scribe's Scribal Practice, which groups the Scribe's Idiographs: Scribe -characterised_by-> Scribal_Practice -P148-> Idiograph."@en
    ] ;
    sh:property [
        sh:path crm:P70i_is_documented_in ;
        sh:class crm:E31_Document ;
        sh:description "Outgoing: Scribe -P70i_is_documented_in-> Reference (E31 Document). Bibliographic References for this Scribe."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P107_has_current_or_former_member ] ;
        sh:class crm:E74_Group ;
        sh:description "Incoming: Institution -P107_has_current_or_former_member-> this Scribe. (CRM inverse P107i_is_current_or_former_member_of; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P14_carried_out_by ] ;
        sh:class crm-tx:TX2_Writing ;
        sh:description "Incoming: Writing event -P14_carried_out_by-> this Scribe. (CRM inverse P14i_performed; not materialised in the export.)"@en
    ] .

archsh:ScribalPracticeShape
    a sh:NodeShape ;
    sh:targetClass archetype:Scribal_Practice ;
    rdfs:label "Scribal Practice"@en ;
    sh:property [
        sh:path crm:P148_has_component ;
        sh:class archetype:Idiograph ;
        sh:description "Outgoing: Scribal Practice -P148_has_component-> Idiograph. The Idiographs that make up this Scribe's practice."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath archetype:characterised_by ] ;
        sh:class archetype:Scribe ;
        sh:description "Incoming: Scribe -characterised_by-> this Scribal Practice."@en
    ] .

archsh:AppearanceShape
    a sh:NodeShape ;
    sh:targetClass archetype:Appearance ;
    rdfs:label "Appearance"@en ;
    sh:property [
        sh:path [ sh:inversePath crm:P2_has_type ] ;
        sh:class archetype:HandInstance ;
        sh:description "Incoming: Hand Instance -P2_has_type-> this Appearance. (CRM inverse P2i_is_type_of; not materialised in the export.)"@en
    ] .


#################################################################
# Manuscripts: items, parts and physical description
#################################################################

archsh:HistoricalItemShape
    a sh:NodeShape ;
    sh:targetClass archetype:Historical_Item ;
    rdfs:label "Historical Item"@en ;
    sh:property [
        sh:path crm:P1_is_identified_by ;
        sh:class crm:E42_Identifier ;
        sh:description "Outgoing: Historical Item -P1_is_identified_by-> Catalogue number (E42 Identifier)."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Historical Item -P2_has_type-> Category or Historical Item format or Historical Item type."@en
    ] ;
    sh:property [
        sh:path crm:P43_has_dimension ;
        sh:class crm:E54_Dimension ;
        sh:description "Outgoing: Historical Item -P43_has_dimension-> Dimension."@en
    ] ;
    sh:property [ # How is Collation a 'physical thing'?
        sh:path crm:P46_is_composed_of ;
        sh:or ( [ sh:class crm:E18_Physical_Thing ] [ sh:class archetype:Item_Part ] ) ;
        sh:description "Outgoing: Historical Item -P46_is_composed_of-> Collation or Decoration or Item Part or Layout. The Item Parts that make up this Historical Item."@en
    ] ;
    sh:property [
        sh:path crm:P72_has_language ;
        sh:class crm:E56_Language ;
        sh:description "Outgoing: Historical Item -P72_has_language-> Language."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P140_assigned_attribute_to ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Archive attribution or Item origin attribution -P140_assigned_attribute_to-> this Historical Item. (CRM inverse P140i_was_attributed_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P70_documents ] ;
        sh:class crm:E31_Document ;
        sh:description "Incoming: Description (of Historical Item or Text) -P70_documents-> this Historical Item. (CRM inverse P70i_is_documented_in; not materialised in the export.)"@en
    ] .

archsh:ItemPartShape
    a sh:NodeShape ;
    sh:targetClass archetype:Item_Part ;
    rdfs:label "Item Part"@en ;
    sh:property [
        sh:path crm:P1_is_identified_by ;
        sh:class crm:E41_Appellation ;   # NO: crm:E42_Identifier is a subclass of E41, but Locus is not an Identifier
        sh:description "Outgoing: Item Part -P1_is_identified_by-> Locus. Every Locus cited within this Item Part (by Images, Hand Instances or Texts)."@en
    ] ;
    sh:property [
        sh:path crm:P43_has_dimension ;
        sh:class crm:E54_Dimension ;
        sh:description "Outgoing: Item Part -P43_has_dimension-> Dimension. Emitted by creation_rdf.py when Layout.item_part_id is set; not populated in DigiPal."@en
    ] ;
    sh:property [
        sh:path crm:P46_is_composed_of ;
        sh:class crm:E18_Physical_Thing ;   # Again, seems wrong here
        sh:description "Outgoing: Item Part -P46_is_composed_of-> Layout. Emitted by creation_rdf.py when Layout.item_part_id is set; not populated in DigiPal (Layout attaches to Historical Item there)."@en
    ] ;
    sh:property [
        sh:path crm:P56_bears_feature ;
        sh:class archetype:HandInstance ;
        sh:description "Outgoing: Item Part -P56_bears_feature-> Hand Instance. The Hand Instances found on this Item Part."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class crm:E36_Visual_Item ;
        sh:description "Incoming: Image -P138_represents-> this Item Part. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P140_assigned_attribute_to ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Ownership attribution -P140_assigned_attribute_to-> this Item Part. (CRM inverse P140i_was_attributed_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:or ( [ sh:class archetype:Current_Item ] [ sh:class archetype:Historical_Item ] ) ;
        sh:description "Incoming: Current Item or Historical Item -P46_is_composed_of-> this Item Part. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] .

archsh:CurrentItemShape
    a sh:NodeShape ;
    sh:targetClass archetype:Current_Item ;
    rdfs:label "Current Item"@en ;
    sh:property [
        sh:path crm:P1_is_identified_by ;
        sh:class crm:E42_Identifier ;
        sh:description "Outgoing: Current Item -P1_is_identified_by-> Shelfmark (E42 Identifier)."@en
    ] ;
    sh:property [
        sh:path crm:P46_is_composed_of ;
        sh:class archetype:Item_Part ;
        sh:description "Outgoing: Current Item -P46_is_composed_of-> Item Part. The Item Parts now bound in this Current Item."@en
    ] ;
    sh:property [
        sh:path crm:P50_has_current_keeper ;
        sh:class crm:E74_Group ;
        sh:description "Outgoing: Current Item -P50_has_current_keeper-> Repository. The Repository that holds this Current Item."@en
    ] ;
    sh:property [   # CHECK!
        sh:path owl:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:description "Outgoing: Current Item -sameAs-> data:Item_<id> (untyped). SUSPECT: points to data:Item_<item part id>, a node with no other triples; see note."@en
    ] .

archsh:LayoutShape          # Doesn't look right at all... Left off diagram for now
    a sh:NodeShape ;
    rdfs:label "Layout"@en ;
    rdfs:comment "Typed only crm:E18_Physical_Thing (shared with Collation and Decoration); identified by URI data:Layout_Historical_Item_<id>, or as the E18 that a Historical Item is composed of and that has no P2_has_type."@en ;
    sh:property [
        sh:path crm:P45_consists_of ;
        sh:class crm:E57_Material ;
        sh:description "Outgoing: Layout -P45_consists_of-> Hair arrangement (E57 Material)."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:or ( [ sh:class archetype:Historical_Item ] [ sh:class archetype:Item_Part ] ) ;
        sh:description "Incoming: Historical Item or Item Part -P46_is_composed_of-> this Layout. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] .

archsh:CollationShape       # Doesn't look right at all... Left off diagram for now
    a sh:NodeShape ;
    rdfs:label "Collation"@en ;
    rdfs:comment "Typed only crm:E18_Physical_Thing; identified by crm:P2_has_type data:Collation."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Collation ) ;
        sh:description "Outgoing: Collation -P2_has_type-> data:Collation."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:class archetype:Historical_Item ;
        sh:description "Incoming: Historical Item -P46_is_composed_of-> this Collation. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] .

archsh:DecorationShape       # Doesn't look right at all... Left off diagram for now
    a sh:NodeShape ;
    rdfs:label "Decoration"@en ;
    rdfs:comment "Typed only crm:E18_Physical_Thing; identified by crm:P2_has_type data:Decoration."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Decoration ) ;
        sh:description "Outgoing: Decoration -P2_has_type-> data:Decoration."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ;
        sh:class archetype:Historical_Item ;
        sh:description "Incoming: Historical Item -P46_is_composed_of-> this Decoration. (CRM inverse P46i_forms_part_of; not materialised in the export.)"@en
    ] .

archsh:DimensionShape          # Doesn't look right at all... Left off diagram for now
    a sh:NodeShape ;
    sh:targetClass crm:E54_Dimension ;
    rdfs:label "Dimension"@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Frame_Height data:Type_Frame_Width data:Type_Page_Height data:Type_Page_Width data:Type_Tramline_Width ) ;
        sh:description "Outgoing: Dimension -P2_has_type-> data:Type_Frame_Height or data:Type_Frame_Width or data:Type_Page_Height or data:Type_Page_Width or data:Type_Tramline_Width."@en
    ] ;
    sh:property [
        sh:path crm:P91_has_unit ;
        sh:in ( data:Measurement_Unit_millimeter ) ;
        sh:description "Outgoing: Dimension -P91_has_unit-> data:Measurement_Unit_millimeter."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P43_has_dimension ] ;
        sh:or ( [ sh:class archetype:Historical_Item ] [ sh:class archetype:Item_Part ] ) ;
        sh:description "Incoming: Historical Item or Item Part -P43_has_dimension-> this Dimension. (CRM inverse P43i_is_dimension_of; not materialised in the export.)"@en
    ] .

archsh:LocusShape       # Doesn't look right at all... Left off diagram for now
    a sh:NodeShape ;
    rdfs:label "Locus"@en ;
    rdfs:comment "Typed crm:E41_Appellation (not targeted by class because crm:E42_Identifier is a subclass of E41); identified by crm:P2_has_type data:Type_Locus. One Locus node per (Item Part, locus string), shared by any Image, Hand Instance or Text-in-Item-Part that cites the same locus."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Locus ) ;
        sh:description "Outgoing: Locus -P2_has_type-> data:Type_Locus."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P138_represents ] ;
        sh:class crm:E36_Visual_Item ;
        sh:description "Incoming: Image -P138_represents-> this Locus. (CRM inverse P138i_has_representation; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P1_is_identified_by ] ;
        sh:or ( [ sh:class archetype:HandInstance ] [ sh:class archetype:Item_Part ] [ sh:class crm-tx:TX7_Written_Text_Segment ] ) ;
        sh:description "Incoming: Hand Instance or Item Part or Text in Item Part -P1_is_identified_by-> this Locus. (CRM inverse P1i_identifies; not materialised in the export.)"@en
    ] .


#################################################################
# Images, annotations and texts
#################################################################

archsh:ImageShape
    a sh:NodeShape ;
    rdfs:label "Image"@en ;
    rdfs:comment "Typed only crm:E36_Visual_Item (not targeted by class because Idiograph, Allograph, Character, VisualComponent etc. are all subclasses of E36); identified as the target of an oa:Annotation, or by URI data:Image_<id>."@en ;
    sh:property [
        sh:path crm:P104_is_subject_to ;
        sh:class crm:E30_Right ;
        sh:description "Outgoing: Image -P104_is_subject_to-> Media permission (E30 Right)."@en
    ] ;
    sh:property [
        sh:path crm:P138_represents ;
        sh:or ( [ sh:class archetype:HandInstance ] [ sh:class archetype:Item_Part ] [ sh:class crm:E41_Appellation ] ) ;
        sh:description "Outgoing: Image -P138_represents-> Hand Instance or Item Part or Locus. The Hand Instances visible in this Image (from hand_images). The Item Part shown in this Image. The locus (folio/page) shown in this Image."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath oa:hasTarget ] ;
        sh:class oa:Annotation ;
        sh:description "Incoming: Annotation -hasTarget-> this Image."@en
    ] .

archsh:AnnotationShape
    a sh:NodeShape ;
    sh:targetClass oa:Annotation ;
    rdfs:label "Annotation"@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Annotation -P2_has_type-> Annotation status (E55 Type)."@en
    ] ;
    sh:property [
        sh:path oa:hasBody ;
        sh:class archetype:Graph ;
        sh:description "Outgoing: Annotation -hasBody-> Graph. The Graph this annotation records."@en
    ] ;
    sh:property [
        sh:path oa:hasTarget ;
        sh:class crm:E36_Visual_Item ;
        sh:description "Outgoing: Annotation -hasTarget-> Image. The Image on which the annotation is drawn."@en
    ] .

archsh:TextShape
    a sh:NodeShape ;
    rdfs:label "Text"@en ;
    rdfs:comment "Typed crm-tx:TX1_Written_Text (not targeted by class because TX7, and so Hand Instance and Graph, are subclasses of TX1 in CRMtex). Typing as TX1 is already flagged in creation_rdf.py as wrong (should be a conceptual text, e.g. E33)."@en ;
    sh:property [
        sh:path crm-tx:TXP4_has_segment ;
        sh:class crm-tx:TX7_Written_Text_Segment ;
        sh:description "Outgoing: Text -TXP4_has_segment-> Text in Item Part. The occurrences of this Text in particular Item Parts."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Text -P2_has_type-> Category."@en
    ] ;
    sh:property [
        sh:path crm:P72_has_language ;
        sh:class crm:E56_Language ;
        sh:description "Outgoing: Text -P72_has_language-> Language."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P70_documents ] ;
        sh:class crm:E31_Document ;
        sh:description "Incoming: Description (of Historical Item or Text) -P70_documents-> this Text. (CRM inverse P70i_is_documented_in; not materialised in the export.)"@en
    ] .

archsh:TextInItemPartShape
    a sh:NodeShape ;
    rdfs:label "Text in Item Part"@en ;
    rdfs:comment "Typed crm-tx:TX7_Written_Text_Segment (not targeted by class because Hand Instance and Graph are also TX7); identified as the object of crm-tx:TXP4_has_segment from a Text."@en ;
    sh:property [
        sh:path crm:P1_is_identified_by ;
        sh:class crm:E41_Appellation ;
        sh:description "Outgoing: Text in Item Part -P1_is_identified_by-> Locus."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm-tx:TXP4_has_segment ] ;
        sh:class crm-tx:TX1_Written_Text ;
        sh:description "Incoming: Text -TXP4_has_segment-> this Text in Item Part."@en
    ] .


#################################################################
# Attributions (E13) and dates
#################################################################

archsh:HandDateAttributionShape # Need also to add Dubitable type (even if not in the export yet) for attributions that are not accepted (see discussion R9)
    a sh:NodeShape ;
    rdfs:label "Hand date attribution"@en ;
    rdfs:comment "Typed only crm:E13_Attribute_Assignment (shared with Hand place, Item origin, Archive and Owner); identified as an E13 whose P140 is a Hand Instance and whose P141 is an E4_Period."@en ;
    sh:property [
        sh:path crm:P140_assigned_attribute_to ;
        sh:class archetype:HandInstance ;
        sh:description "Outgoing: Hand date attribution -P140_assigned_attribute_to-> Hand Instance. Accepted date of a Hand Instance: HandInstance <-P140- HandDate -P141-> Date."@en
    ] ;
    sh:property [
        sh:path crm:P141_assigned ;
        sh:class crm:E4_Period ;
        sh:description "Outgoing: Hand date attribution -P141_assigned-> Date."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Accepted ) ;
        sh:description "Outgoing: Hand date attribution -P2_has_type-> data:Type_Accepted."@en
    ] .

archsh:HandPlaceAttributionShape    # Need also to add Dubitable type (even if not in the export yet) for attributions that are not accepted (see discussion R9)
    a sh:NodeShape ;
    rdfs:label "Hand place attribution"@en ;
    rdfs:comment "Typed only crm:E13_Attribute_Assignment; identified as an E13 whose P140 is a Hand Instance and whose P141 is an E53_Place."@en ;
    sh:property [
        sh:path crm:P140_assigned_attribute_to ;
        sh:class archetype:HandInstance ;
        sh:description "Outgoing: Hand place attribution -P140_assigned_attribute_to-> Hand Instance. Accepted place of a Hand Instance: HandInstance <-P140- HandPlace -P141-> Place."@en
    ] ;
    sh:property [
        sh:path crm:P141_assigned ;
        sh:class crm:E53_Place ;
        sh:description "Outgoing: Hand place attribution -P141_assigned-> Place."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Accepted ) ;
        sh:description "Outgoing: Hand place attribution -P2_has_type-> data:Type_Accepted."@en
    ] .

archsh:ItemOriginAttributionShape
    a sh:NodeShape ;
    rdfs:label "Item origin attribution"@en ;
    rdfs:comment "Typed only crm:E13_Attribute_Assignment; identified as an E13 whose P140 is a Historical Item (URIs data:ItemOrigin_<id>; indistinguishable by structure from Archive when P141 is a Place)."@en ;
    sh:property [
        sh:path crm:P140_assigned_attribute_to ;
        sh:class archetype:Historical_Item ;
        sh:description "Outgoing: Item origin attribution -P140_assigned_attribute_to-> Historical Item."@en
    ] ;
    sh:property [
        sh:path crm:P141_assigned ;
        sh:or ( [ sh:class crm:E74_Group ] [ sh:class crm:E53_Place ] ) ;
        sh:description "Outgoing: Item origin attribution -P141_assigned-> Institution or Place. The place (or institution) of origin."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Dubitable ) ;
        sh:description "Outgoing: Item origin attribution -P2_has_type-> data:Type_Dubitable."@en
    ] .

archsh:ArchiveAttributionShape
    a sh:NodeShape ;
    rdfs:label "Archive attribution"@en ;
    rdfs:comment "Typed only crm:E13_Attribute_Assignment; identified as an E13 whose P140 is a Historical Item (URIs data:Archive_<id>; indistinguishable by structure from Item origin)."@en ;
    sh:property [
        sh:path crm:P140_assigned_attribute_to ;
        sh:class archetype:Historical_Item ;
        sh:description "Outgoing: Archive attribution -P140_assigned_attribute_to-> Historical Item."@en
    ] ;
    sh:property [
        sh:path crm:P141_assigned ;
        sh:class crm:E53_Place ;
        sh:description "Outgoing: Archive attribution -P141_assigned-> Place. The archive's place."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Dubitable ) ;
        sh:description "Outgoing: Archive attribution -P2_has_type-> data:Type_Dubitable."@en
    ] .

archsh:OwnershipAttributionShape
    a sh:NodeShape ;
    rdfs:label "Ownership attribution"@en ;
    rdfs:comment "Typed only crm:E13_Attribute_Assignment; identified as an E13 whose P140 is an Item Part. Records an assertion of ownership, not the owner itself."@en ;
    sh:property [
        sh:path crm:P140_assigned_attribute_to ;
        sh:class archetype:Item_Part ;
        sh:description "Outgoing: Ownership attribution -P140_assigned_attribute_to-> Item Part. The Item Part whose ownership is asserted."@en
    ] ;
    sh:property [
        sh:path crm:P141_assigned ;
        sh:or ( [ sh:class crm:E74_Group ] [ sh:class crm:E21_Person ] ) ;
        sh:description "Outgoing: Ownership attribution -P141_assigned-> Repository or Person (E21) or Institution. The owner. Person and Institution owners are emitted by creation_rdf.py but not populated in DigiPal."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Dubitable ) ;
        sh:description "Outgoing: Ownership attribution -P2_has_type-> data:Type_Dubitable."@en
    ] .

archsh:DateShape
    a sh:NodeShape ;
    rdfs:label "Date"@en ;
    rdfs:comment "Typed crm:E4_Period (not targeted by class because every E5 Event, e.g. Writing, Formation and E13 Attribute Assignment, is a subclass of E4); URIs data:Date_Period_<id>."@en ;
    sh:property [
        sh:path crm:P4_has_time-span ;
        sh:class crm:E52_Time-Span ;
        sh:description "Outgoing: Date -P4_has_time-span-> Date time-span."@en
    ] ;
    sh:property [
        sh:path crm:P70i_is_documented_in ;
        sh:class crm:E31_Document ;
        sh:description "Outgoing: Date -P70i_is_documented_in-> Date evidence document (E31 Document). The node carrying the evidence note for this date."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P141_assigned ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Hand date attribution -P141_assigned-> this Date. (CRM inverse P141i_was_assigned_by; not materialised in the export.)"@en
    ] .

archsh:DateTimeSpanShape
    a sh:NodeShape ;
    sh:targetClass crm:E52_Time-Span ;
    rdfs:label "Date time-span"@en ;
    sh:property [
        sh:path [ sh:inversePath crm:P4_has_time-span ] ;
        sh:class crm:E4_Period ;
        sh:description "Incoming: Date -P4_has_time-span-> this Date time-span. (CRM inverse P4i_is_time-span_of; not materialised in the export.)"@en
    ] .


#################################################################
# Agents, places and documentation
#################################################################

archsh:InstitutionShape
    a sh:NodeShape ;
    rdfs:label "Institution"@en ;
    rdfs:comment "Typed only crm:E74_Group (shared with Repository); URIs data:Institution_<id>."@en ;
    sh:property [
        sh:path crm:P107_has_current_or_former_member ;
        sh:class archetype:Scribe ;
        sh:description "Outgoing: Institution -P107_has_current_or_former_member-> Scribe. Scribes of this Institution (scriptorium)."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Institution -P2_has_type-> Institution type (E55 Type)."@en
    ] ;
    sh:property [
        sh:path crm:P74_has_current_or_former_residence ;
        sh:class crm:E53_Place ;
        sh:description "Outgoing: Institution -P74_has_current_or_former_residence-> Place."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P141_assigned ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Item origin attribution or Ownership attribution -P141_assigned-> this Institution. (CRM inverse P141i_was_assigned_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P95_has_formed ] ;
        sh:class crm:E66_Formation ;
        sh:description "Incoming: Institution foundation / refoundation -P95_has_formed-> this Institution. (CRM inverse P95i_was_formed_by; not materialised in the export.)"@en
    ] .

archsh:RepositoryShape
    a sh:NodeShape ;
    rdfs:label "Repository"@en ;
    rdfs:comment "Typed only crm:E74_Group (shared with Institution); identified as the object of crm:P50_has_current_keeper, or by URI data:Repository_<id>."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:class crm:E55_Type ;
        sh:description "Outgoing: Repository -P2_has_type-> Repository type (E55 Type)."@en
    ] ;
    sh:property [
        sh:path crm:P74_has_current_or_former_residence ;
        sh:class crm:E53_Place ;
        sh:description "Outgoing: Repository -P74_has_current_or_former_residence-> Place."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P141_assigned ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Ownership attribution -P141_assigned-> this Repository. (CRM inverse P141i_was_assigned_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P50_has_current_keeper ] ;
        sh:class archetype:Current_Item ;
        sh:description "Incoming: Current Item -P50_has_current_keeper-> this Repository. (CRM inverse P50i_is_current_keeper_of; not materialised in the export.)"@en
    ] .

archsh:InstitutionFoundationOrRefoundationShape
    a sh:NodeShape ;
    sh:targetClass crm:E66_Formation ;
    rdfs:label "Institution foundation / refoundation"@en ;
    rdfs:comment "Two kinds of node share this shape, distinguished by P2_has_type data:Type_Fondation or data:Type_Refondation."@en ;
    sh:property [
        sh:path crm:P14_carried_out_by_founder ;
        sh:class crm:E21_Person ;
        sh:description "Outgoing: Institution foundation / refoundation -P14_carried_out_by_founder-> Person (E21). NOT A CIDOC-CRM PROPERTY: see note."@en
    ] ;
    sh:property [
        sh:path crm:P14_carried_out_by_reformer ;
        sh:class crm:E21_Person ;
        sh:description "Outgoing: Institution foundation / refoundation -P14_carried_out_by_reformer-> Person (E21). NOT A CIDOC-CRM PROPERTY: see note."@en
    ] ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Fondation data:Type_Refondation ) ;
        sh:description "Outgoing: Institution foundation / refoundation -P2_has_type-> data:Type_Fondation or data:Type_Refondation."@en
    ] ;
    sh:property [
        sh:path crm:P95_has_formed ;
        sh:class crm:E74_Group ;
        sh:description "Outgoing: Institution foundation / refoundation -P95_has_formed-> Institution."@en
    ] .

archsh:PlaceShape
    a sh:NodeShape ;
    sh:targetClass crm:E53_Place ;
    rdfs:label "Place"@en ;
    rdfs:comment "Covers three kinds of node with no class distinction: site-level Places (data:Place_<id>), Counties (data:County_<id>) and Regions (data:Region_<id>)."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Current_County data:Type_Historical_County data:Type_Region ) ;
        sh:description "Outgoing: Place -P2_has_type-> data:Type_Current_County or data:Type_Historical_County or data:Type_Region."@en
    ] ;
    sh:property [
        sh:path crm:P89_falls_within ;
        sh:class crm:E53_Place ;
        sh:description "Outgoing: Place -P89_falls_within-> Place."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P141_assigned ] ;
        sh:class crm:E13_Attribute_Assignment ;
        sh:description "Incoming: Archive attribution or Hand place attribution or Item origin attribution -P141_assigned-> this Place. (CRM inverse P141i_was_assigned_by; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P74_has_current_or_former_residence ] ;
        sh:class crm:E74_Group ;
        sh:description "Incoming: Institution or Repository -P74_has_current_or_former_residence-> this Place. (CRM inverse P74i_is_current_or_former_residence_of; not materialised in the export.)"@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P89_falls_within ] ;
        sh:class crm:E53_Place ;
        sh:description "Incoming: Place -P89_falls_within-> this Place. (CRM inverse P89i_contains; not materialised in the export.)"@en
    ] .

archsh:DescriptionOfHistoricalItemOrTextShape
    a sh:NodeShape ;
    rdfs:label "Description (of Historical Item or Text)"@en ;
    rdfs:comment "Typed only crm:E31_Document (shared with Hand description, Source, Reference, Date evidence); URIs data:Description_<id>."@en ;
    sh:property [
        sh:path crm:P70_documents ;
        sh:or ( [ sh:class archetype:Historical_Item ] [ sh:class crm-tx:TX1_Written_Text ] ) ;
        sh:description "Outgoing: Description (of Historical Item or Text) -P70_documents-> Historical Item or Text."@en
    ] ;
    sh:property [
        sh:path crm:P70i_is_documented_in ;
        sh:class crm:E31_Document ;
        sh:description "Outgoing: Description (of Historical Item or Text) -P70i_is_documented_in-> Source (E31 Document). The Source this description comes from."@en
    ] .

archsh:HandDescriptionShape
    a sh:NodeShape ;
    rdfs:label "Hand description"@en ;
    rdfs:comment "Typed only crm:E31_Document; identified as an E31 with crm:P67_refers_to a Hand Instance."@en ;
    sh:property [
        sh:path crm:P67_refers_to ;
        sh:class archetype:HandInstance ;
        sh:description "Outgoing: Hand description -P67_refers_to-> Hand Instance. The Hand Instance described."@en     # No: should be P70_documents, but that is not in the export
    ] ;
    sh:property [
        sh:path crm:P70i_is_documented_in ;
        sh:class crm:E31_Document ;
        sh:description "Outgoing: Hand description -P70i_is_documented_in-> Source (E31 Document)."@en
    ] .

archsh:CategoryShape
    a sh:NodeShape ;
    rdfs:label "Category"@en ;
    rdfs:comment "Typed only crm:E55_Type; identified by crm:P2_has_type data:Category_Historical_Item. Used for Historical Items, Texts and (as glossed text) Hand Instances."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Category_Historical_Item ) ;
        sh:description "Outgoing: Category -P2_has_type-> data:Category_Historical_Item."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P2_has_type ] ;
        sh:or ( [ sh:class archetype:HandInstance ] [ sh:class archetype:Historical_Item ] [ sh:class crm-tx:TX1_Written_Text ] ) ;
        sh:description "Incoming: Hand Instance or Historical Item or Text -P2_has_type-> this Category. (CRM inverse P2i_is_type_of; not materialised in the export.)"@en
    ] .

archsh:HistoricalItemTypeShape
    a sh:NodeShape ;
    rdfs:label "Historical Item type"@en ;
    rdfs:comment "Typed only crm:E55_Type; identified by crm:P2_has_type data:TYPE_Historical_Item."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:TYPE_Historical_Item ) ;
        sh:description "Outgoing: Historical Item type -P2_has_type-> data:TYPE_Historical_Item."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P2_has_type ] ;
        sh:class archetype:Historical_Item ;
        sh:description "Incoming: Historical Item -P2_has_type-> this Historical Item type. (CRM inverse P2i_is_type_of; not materialised in the export.)"@en
    ] .

archsh:HistoricalItemFormatShape
    a sh:NodeShape ;
    rdfs:label "Historical Item format"@en ;
    rdfs:comment "Typed only crm:E55_Type; identified by crm:P2_has_type data:Type_Format."@en ;
    sh:property [
        sh:path crm:P2_has_type ;
        sh:in ( data:Type_Format ) ;
        sh:description "Outgoing: Historical Item format -P2_has_type-> data:Type_Format."@en
    ] ;
    sh:property [
        sh:path [ sh:inversePath crm:P2_has_type ] ;
        sh:class archetype:Historical_Item ;
        sh:description "Incoming: Historical Item -P2_has_type-> this Historical Item format. (CRM inverse P2i_is_type_of; not materialised in the export.)"@en
    ] .
